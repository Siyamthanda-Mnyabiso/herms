# Copy to .env and fill in. .env is git-ignored; load it before starting the backend:
#   set -a; source .env; set +a; ./mvnw spring-boot:run
# In IntelliJ, put the same names under Run > Edit Configurations > Environment variables.

# Required: password for the MySQL user (user defaults to root; set MYSQL_USER to change it)
MYSQL_PASSWORD=
# Optional: creates an admin account at startup if this email does not exist yet
HERMS_ADMIN_EMAIL=
HERMS_ADMIN_PASSWORD=

# Password reset emails. Leave SPRING_MAIL_HOST empty in development: the reset link is then
# printed in the backend log instead of being emailed.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=no-reply@herms.local
# Where reset links point (the frontend's address)
FRONTEND_URL=http://localhost:5173
